# Copy to .env.local (eve dev loads it), or save each value with `npm run add-key -- <NAME>`.
# Felspar's MCP endpoint and this agent's own key.
FELSPAR_MCP_URL=https://mcp.felspar.ai/mcp
FELSPAR_AGENT_KEY=
# Optional: the job npm run evaluate runs, by its ID (list_jobs, or Workspace → Agents). Empty, the agent picks from list_jobs.
FELSPAR_JOB=
# Optional: Exa key for more than the free search rate.
EXA_API_KEY=
# Vercel AI Gateway key for the agent's model (or connect one with /login).
AI_GATEWAY_API_KEY=
