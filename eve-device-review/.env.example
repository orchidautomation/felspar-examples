# Copy to .env.local and fill in. Keep it out of Git and chat.

# Your agent's key: app.felspar.ai → Workspace → Company agents
FELSPAR_AGENT_KEY=

# A Vercel AI Gateway key for the model (or leave empty and use /login in npm run dev)
AI_GATEWAY_API_KEY=

# The released Felspar job this agent runs
FELSPAR_JOB=device-review

# Your own MCP servers: one that searches the research systems, one that takes the review actions
RESEARCH_MCP_URL=http://127.0.0.1:8790/research/mcp
REVIEW_MCP_URL=http://127.0.0.1:8790/review/mcp
