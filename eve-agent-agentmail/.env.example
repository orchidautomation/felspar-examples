# Copy to .env.local and fill in. Keep it out of Git and chat.

# Your agent's key: app.felspar.ai → Workspace → Company agents
FELSPAR_AGENT_KEY=

# A Vercel AI Gateway key for the model (or leave empty and use /login in npm run dev)
AI_GATEWAY_API_KEY=

# AgentMail: an API key and the one inbox the agent drafts from. Either unset denies every draft.
AGENTMAIL_API_KEY=
FELSPAR_AGENT_INBOX=

# The gate: the job whose decisions may draft, and the output a draft writes (its id in the pack;
# get_job_requirements lists each outcome's outputs). Unset, every draft is denied.
FELSPAR_JOB=support-ticket-routing
FELSPAR_GATE_OUTPUT=customer-reply
# For a job about records such as tickets, the draft field that names the case. Empty for a job about companies.
FELSPAR_GATE_ENTITY_FIELD=labels
# Optional test mode: the only addresses a draft may go to, comma-separated.
FELSPAR_GATE_RECIPIENTS=

# Optional: more web searches than Exa's free rate
EXA_API_KEY=
