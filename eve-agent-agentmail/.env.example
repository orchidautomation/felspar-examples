# Copy to .env.local (eve dev loads it). Felspar's MCP endpoint and this agent's own key.
FELSPAR_MCP_URL=https://mcp.felspar.ai/mcp
FELSPAR_AGENT_KEY=
# Optional: the job npm run evaluate runs and the AgentMail gate drafts for, by its ID (list_jobs, or Workspace → Agents). Empty, the agent picks from list_jobs.
FELSPAR_JOB=
# Optional: Exa key for more than the free search rate.
EXA_API_KEY=
# Vercel AI Gateway key for the agent's model (or connect one with /login).
AI_GATEWAY_API_KEY=
# Optional: AgentMail key for the gated email example, and the only recipients a gated draft may address.
AGENTMAIL_API_KEY=
FELSPAR_GATE_RECIPIENTS=
# The one AgentMail inbox the agent may draft from; unset, every draft is denied.
FELSPAR_AGENT_INBOX=
# The output a draft writes, by its id in the released pack (get_job_requirements lists each outcome's outputs); unset, every draft is denied.
FELSPAR_GATE_OUTPUT=
# For a job whose case is a record (such as a ticket), the draft field that holds its ID: labels. Leave empty for a company job.
FELSPAR_GATE_ENTITY_FIELD=
