# Put these in the environment the CLI runs in (your shell profile, or the
# CLI's managed settings), not in a file the agent can read.
FELSPAR_AGENT_KEY=
LINEAR_API_KEY=
# status:<name> (default status:Approved) or label:<name>
FELSPAR_LINEAR_APPROVAL=status:Approved
# shadow (default) or enforce
FELSPAR_MODE=shadow
