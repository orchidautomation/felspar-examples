{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/felspar-hook.mjs",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
